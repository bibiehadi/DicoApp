<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/nav_upcoming_event">

    <fragment
        android:id="@+id/nav_upcoming_event"
        android:name="com.example.dicoapp.ui.upcoming_event.UpcomingFragment"
        android:label="fragment_upcoming"
        tools:layout="@layout/fragment_upcoming">
        <action
            android:id="@+id/action_nav_upcoming_event_to_detailEventActivity"
            app:destination="@id/detailEventActivity" />
    </fragment>
    <fragment
        android:id="@+id/nav_event_done"
        android:name="com.example.dicoapp.ui.finished_event.FinishedFragment"
        android:label="fragment_finished"
        tools:layout="@layout/fragment_finished">
        <action
            android:id="@+id/action_nav_event_done_to_detailEventActivity"
            app:destination="@id/detailEventActivity" />
    </fragment>
    <activity
        android:id="@+id/detailEventActivity"
        android:name="com.example.dicoapp.ui.detail_event.DetailEventActivity"
        android:label="activity_detail_event"
        tools:layout="@layout/activity_detail_event">
        <argument
            android:name="extra_event_id"
            app:argType="string" />
    </activity>
</navigation>