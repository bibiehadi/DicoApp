<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.detail_event.DetailEventActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Detail Event"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/view_button"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_event_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginHorizontal="16dp"
                android:contentDescription="@string/this_is_the_poster_event"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools:sample/avatars" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tv_event_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/iv_event_image"
                app:layout_constraintStart_toStartOf="@id/iv_event_image"
                android:text="@string/tv_event_category" />

            <TextView
                android:id="@+id/tv_event_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/tv_event_category"
                app:layout_constraintStart_toStartOf="@id/tv_event_category"
                tools:text="@string/event_title_name" />

            <TextView
                android:id="@+id/tv_event_owner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/tv_event_name"
                app:layout_constraintStart_toStartOf="@id/tv_event_name"
                tools:text="@string/tv_owner" />


            <!-- 1. Background: taruh PALING ATAS biar posisinya di belakang -->
            <View
                android:id="@+id/view_event"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_event_owner"
                app:layout_constraintBottom_toBottomOf="@id/space_bottom"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@drawable/bg_rounded_box"
                app:layout_constraintEnd_toEndOf="@id/tv_event_info" />

            <!-- 2. Isi: kasih margin biar ada "padding" di dalam kotak -->
            <include
                android:id="@+id/row_date"
                layout="@layout/row_detail_event"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="@id/view_event"
                app:layout_constraintStart_toStartOf="@id/view_event"
                app:layout_constraintEnd_toEndOf="@id/view_event" />

            <include
                android:id="@+id/row_location"
                layout="@layout/row_detail_event"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/row_date"
                app:layout_constraintStart_toStartOf="@id/row_date"
                app:layout_constraintEnd_toEndOf="@id/row_date" />

            <include
                android:id="@+id/row_quota"
                layout="@layout/row_detail_event"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/row_location"
                app:layout_constraintStart_toStartOf="@id/row_date"
                app:layout_constraintEnd_toEndOf="@id/row_date" />

            <!-- 3. Pengganjal buat "padding bawah" kotak -->
            <Space
                android:id="@+id/space_bottom"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constraintTop_toBottomOf="@id/row_quota"
                app:layout_constraintStart_toStartOf="@id/view_event"
                app:layout_constraintEnd_toEndOf="@id/view_event" />

            <TextView
                android:id="@+id/tv_event_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/space_bottom"
                app:layout_constraintStart_toStartOf="@id/space_bottom"
                tools:text="@string/tv_event_info" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:textSize="12sp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_event_info"
                app:layout_constraintStart_toStartOf="@id/tv_event_info"
                tools:text="@string/event_desc" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


    <View
        android:id="@+id/view_button"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/btn_register"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/btn_register"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:icon="@drawable/ic_register"
        app:iconSize="24dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:layout_constraintEnd_toStartOf="@id/btn_favorite"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_favorite"
        style="?attr/materialIconButtonOutlinedStyle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        app:icon="@drawable/ic_favorite_border"
        app:iconSize="24dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_register"
        app:layout_constraintBottom_toBottomOf="@id/btn_register" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>